<?xml version="1.0" encoding="utf-8"?>
<!-- CI ONLY: temporary LocalDB instance used to scaffold EF6 migrations.
     Do not deploy this file or use it as the live site's connection config. -->
<configuration>
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=NineStarKiOAuthScaffolding;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
