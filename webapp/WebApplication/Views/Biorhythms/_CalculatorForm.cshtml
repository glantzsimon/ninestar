@model K9.WebApplication.Models.BioRhythmsModel

@using (Html.BeginForm("IndexPost", "Biorhythms", FormMethod.Post, new { data_calculator_page = "biorhythms", data_calculator_restore = (Request.HttpMethod == "GET").ToString().ToLowerInvariant() }))
{
    @Html.Partial("_CalculatorTrialNotice", "biorhythms")
    using (Html.BeginBootstrapForm())
    {
        @Html.BootstrapEditorFor(model => model.PersonModel.Name, new EditorOptions
        {
            Label = Dictionary.OptionalNameLabel
        })
        @Html.BootstrapEditorFor(model => model.PersonModel.DateOfBirth)
        <div data-toggle="tooltip" data-placement="top" title="@Dictionary.GenderSelectionTooltip">
            @Html.BootstrapEditorFor(model => model.PersonModel.Gender)
        </div>

        <hr />
        @Html.BootstrapButton(Dictionary.Calculate, EButtonType.Submit, "", EButtonClass.Large)
    }
}