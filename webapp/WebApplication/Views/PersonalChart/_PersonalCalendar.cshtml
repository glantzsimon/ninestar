@using System.Globalization
@using K9.Globalisation
@{
    Func<string, string> text = key => Dictionary.ResourceManager.GetString(key, Dictionary.Culture);
}

<link rel="stylesheet" href="@Url.Content("~/Content/controls/personal-calendar.css")" />
<div id="personal-calendar" data-month-url="@Url.Action("Month", "PersonalCalendar")"
     data-subscription-url="@Url.Action("Subscription", "PersonalCalendar")"
     data-revoke-url="@Url.Action("Revoke", "PersonalCalendar")"
     data-loading="@Dictionary.Loading" data-error="@Dictionary.NetworkError" data-unavailable="@text("PersonalCalendarUnavailable")"
     data-title="@text("PersonalCalendar")"
     data-copied="@Dictionary.Copied" data-copy-error="@Dictionary.FailedToCopyToClipboard"
     data-expand="@text("ExpandCalendar")" data-close="@text("CloseCalendar")"
     data-revoked="@text("CalendarLinkDisabled")">
    @Html.AntiForgeryToken()
    <div class="personal-calendar-actions">
        <strong class="personal-calendar-expanded-title">@text("PersonalCalendar")</strong>
        <button type="button" class="btn btn-link calendar-help" data-toggle="collapse" data-target="#personal-calendar-help"
                aria-controls="personal-calendar-help" aria-expanded="false" title="@text("CalendarHelp")" aria-label="@text("CalendarHelp")">
            <i class="fa fa-question-circle" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-default calendar-expand" aria-expanded="false">
            <i class="fa fa-expand" aria-hidden="true"></i> <span>@text("ExpandCalendar")</span>
        </button>
    </div>
    <div id="personal-calendar-help" class="collapse">
        <p>@text("PersonalCalendarHelp")</p>
        <p>@text("CalendarSubscriptionHelp")</p>
    </div>
    <div class="personal-calendar-toolbar">
        <button type="button" class="btn btn-default calendar-previous" title="@text("PreviousMonth")" aria-label="@text("PreviousMonth")">
            <i class="fa fa-chevron-left" aria-hidden="true"></i>
        </button>
        <strong class="personal-calendar-month" aria-live="polite"></strong>
        <button type="button" class="btn btn-default calendar-next" title="@text("NextMonth")" aria-label="@text("NextMonth")">
            <i class="fa fa-chevron-right" aria-hidden="true"></i>
        </button>
        <button type="button" class="btn btn-default calendar-today">@text("Today")</button>
    </div>
    <div class="personal-calendar-content">
        <div class="personal-calendar-grid">
            @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" })
            {
                <div class="personal-calendar-weekday" title="@text(day)">@text(day).Substring(0, Math.Min(3, text(day).Length))</div>
            }
        </div>
        <div class="personal-calendar-detail" aria-live="polite">
            <h4 class="calendar-selected-date"></h4>
            <p class="calendar-selected-houses"></p>
            <div class="calendar-selected-description"></div>
        </div>
    </div>
    <p class="personal-calendar-status" role="status" aria-live="polite">@Dictionary.Loading</p>
    <div class="personal-calendar-subscription">
        <button type="button" class="btn btn-primary calendar-copy">@text("CopyCalendarLink")</button>
        <button type="button" class="btn btn-link calendar-disable" style="display: none;">@text("DisableCalendarLink")</button>
        <div class="calendar-link-container" style="display: none;">
            <label for="personal-calendar-link">@text("CalendarLink")</label>
            <input id="personal-calendar-link" class="form-control" type="text" readonly autocomplete="off" />
            <p>@text("CalendarSubscriptionHelp")</p>
        </div>
    </div>
</div>
<script src="@Url.Content("~/Scripts/personal-calendar.js")"></script>
