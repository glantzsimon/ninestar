@model K9.WebApplication.Models.NineStarKiModel
<div class="inline-form">
    @using (Html.BeginForm("IndexPost", "Predictions", FormMethod.Post, new { data_calculator_page = "predictions", data_calculator_restore = "false", data_calculator_hidden_inputs = "true" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.PersonModel.Name)
        @Html.HiddenFor(model => model.PersonModel.DateOfBirth, new { data_calculator_date = Model.PersonModel.DateOfBirth.ToString("yyyy-MM-dd") })
        @Html.HiddenFor(model => model.PersonModel.TimeOfBirth)
        @Html.HiddenFor(model => model.PersonModel.BirthTimeZoneId)
        @Html.HiddenFor(model => model.PersonModel.Gender)
        @Html.HiddenFor(model => model.SelectedDate)
        @Html.HiddenFor(model => model.SelectedTime)
        @Html.HiddenFor(model => model.UserTimeZoneId)

        @Html.BootstrapButton(Dictionary.YearlyAndMonthlyCycles, EButtonType.Submit, "fa fa-moon", EButtonClass.Large)
    }
</div>